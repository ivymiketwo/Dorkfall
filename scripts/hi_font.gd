static func text_width(text: String, px: float) -> float:
	return maxf(text.length() * ADVANCE - 1, 0) * px


## 1234 -> "1.2k", 10500 -> "10.5k", 1000000 -> "1M". Below 1000 stays as is.
static func short_count(n: int) -> String:
	if n >= 1000000:
		return _tenths(n / 100000) + "M"
	if n >= 1000:
		return _tenths(n / 100) + "k"
	return str(n)


static func _tenths(t: int) -> String:   # t = value * 10, truncated
	return str(t / 10) if t % 10 == 0 else "%d.%d" % [t / 10, t % 10]


static func draw(canvas: CanvasItem, pos: Vector2, text: String, color: Color, px: float, small := false) -> void:
	var glyphs: Dictionary = SMALL_GLYPHS if small else GLYPHS
	var gw := 4 if small else W
	var adv := gw + 1
	var outline := Color(0.05, 0.03, 0.02, 0.95)
	var offsets := [Vector2(-1, -1), Vector2(0, -1), Vector2(1, -1), Vector2(-1, 0),
			Vector2(1, 0), Vector2(-1, 1), Vector2(0, 1), Vector2(1, 1)]
	for pass_index in 2:
		for i in text.length():
			var glyph: String = glyphs.get(text[i], "")
			for k in glyph.length():
				if glyph[k] != "1":
					continue
				var base := pos + Vector2(i * adv + k % gw, k / gw) * px
				if pass_index == 0:
					for o: Vector2 in offsets:
						canvas.draw_rect(Rect2(base + o * px, Vector2(px, px)), outline)
				else:
					canvas.draw_rect(Rect2(base, Vector2(px, px)), color)
