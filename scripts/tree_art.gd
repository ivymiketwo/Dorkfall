class_name TreeArt
## Rex's big forest trees, shared by single trees (tree.gd) and forests (forest.gd).
## They all live in one picture, art/trees_atlas.png, packed by tools/pack_trees.py from
## art/trees_src/ (one shared picture lets the graphics card draw a whole forest in a few goes).
## Drawn one picture pixel per world pixel, like the buildings, so a 128 px tree is about as tall
## as a cottage. "region" is the tree's rectangle in the atlas, "base" is where its trunk meets
## the ground (inside that rectangle): the tree's position in the world.

const ATLAS := preload("res://art/trees_atlas.png")

# --- generated by tools/pack_trees.py: don't edit by hand ---
const SHADE_STEP := 456.0
const SHADE_COUNT := 4
const KINDS := {
	"autumn_round": {"region": Rect2(0, 0, 128, 128), "base": Vector2(61, 119)},
	"willow_teal": {"region": Rect2(130, 0, 128, 128), "base": Vector2(63, 121)},
	"oak_round": {"region": Rect2(260, 0, 128, 128), "base": Vector2(63, 120)},
	"willow_twisted": {"region": Rect2(390, 0, 128, 128), "base": Vector2(63, 122)},
	"fir": {"region": Rect2(0, 130, 128, 128), "base": Vector2(64, 120)},
	"oak_dark": {"region": Rect2(130, 130, 128, 128), "base": Vector2(63, 120)},
	"autumn_gnarled": {"region": Rect2(260, 130, 128, 128), "base": Vector2(61, 122)},
	"birch_willow": {"region": Rect2(390, 130, 128, 128), "base": Vector2(64, 120)},
	"willow_mossy": {"region": Rect2(0, 260, 128, 128), "base": Vector2(61, 120)},
	"pine_small": {"region": Rect2(130, 260, 80, 80), "base": Vector2(40, 77)},
	"blossom": {"region": Rect2(212, 260, 80, 80), "base": Vector2(40, 77)},
	"apple": {"region": Rect2(294, 260, 80, 80), "base": Vector2(40, 76)},
	"twisted": {"region": Rect2(376, 260, 80, 80), "base": Vector2(41, 77)},
	"jungle": {"region": Rect2(458, 260, 80, 80), "base": Vector2(39, 77)},
	"std_pine_dark": {"region": Rect2(540, 260, 36, 68), "base": Vector2(17, 66)},
	"std_pine": {"region": Rect2(578, 260, 38, 68), "base": Vector2(18, 66)},
	"std_gnarled": {"region": Rect2(0, 390, 45, 64), "base": Vector2(21, 62)},
	"std_round_wide": {"region": Rect2(47, 390, 49, 61), "base": Vector2(24, 59)},
	"std_round_big": {"region": Rect2(98, 390, 50, 60), "base": Vector2(25, 58)},
	"std_round_light": {"region": Rect2(150, 390, 44, 58), "base": Vector2(21, 56)},
	"std_round_small": {"region": Rect2(196, 390, 30, 47), "base": Vector2(14, 45)},
}
# --- end of generated part ---


static func has(kind: String) -> bool:
	return KINDS.has(kind)


## Sets up a Sprite2D to show this tree with its trunk base at the sprite's position.
## shade 0 = as drawn, up to SHADE_COUNT - 1 = darkest (for deep inside a forest).
static func apply(s: Sprite2D, kind: String, shade := 0) -> void:
	var k: Dictionary = KINDS[kind]
	s.texture = ATLAS
	s.region_enabled = true
	var r: Rect2 = k.region
	r.position.y += SHADE_STEP * clampi(shade, 0, SHADE_COUNT - 1)
	s.region_rect = r
	s.centered = false
	s.scale = Vector2.ONE
	s.offset = -(k.base as Vector2)


## The tree picture's size (world px).
static func size(kind: String) -> Vector2:
	return (KINDS[kind].region as Rect2).size


## How much bigger than an old small tree (about 45 px tall) this one's shadow should be.
static func shadow_scale(kind: String) -> float:
	return clampf(size(kind).y / 52.0, 1.0, 2.4)
