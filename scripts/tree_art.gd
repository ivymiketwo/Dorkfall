static func has(kind: String) -> bool:
	return KINDS.has(kind)


## Sets up a Sprite2D to show this tree with its trunk base at the sprite's position.
## shade 0 = as drawn, up to SHADE_COUNT - 1 = darkest (for deep inside a forest).
static func apply(s: Sprite2D, kind: String, shade := 0) -> void:
	var k: Dictionary = KINDS[kind]
	s.texture = ATLAS
	s.region_enabled = true
	var r: Rect2 = k.region
	r.position.y += SHADE_STEP * clampi(shade, 0, SHADE_COUNT - 1)
	s.region_rect = r
	s.centered = false
	s.scale = Vector2.ONE
	s.offset = -(k.base as Vector2)


## The tree picture's size (world px).
static func size(kind: String) -> Vector2:
	return (KINDS[kind].region as Rect2).size


## How much bigger than an old small tree (about 45 px tall) this one's shadow should be.
static func shadow_scale(kind: String) -> float:
	return clampf(size(kind).y / 52.0, 1.0, 2.4)
